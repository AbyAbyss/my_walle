{
  "onboarding_complete": false,
  "last_open_date": "",
  "user_level": "standard",
  "user": {
    "name": "User"
  },
  "llm": {
    "provider": "anthropic",
    "default_model": "claude-haiku-4-5-20251001",
    "complex_model": "claude-sonnet-4-6",
    "smart_routing": true,
    "base_url": "",
    "api_key_env": "ANTHROPIC_API_KEY",
    "max_tokens": 512,
    "temperature": 0.7
  },
  "agent": {
    "mode": "manual_review",
    "auto_summarize_tool_output": true,
    "always_confirm_dangerous": true,
    "always_confirm_moderate": true,
    "action_delay_ms": 600
  },
  "workflows": [],
  "mascot": {
    "active": "walle",
    "position": "bottom-right",
    "scale": 1.0,
    "idle_animation": true,
    "idle_wander": true,
    "window_x": null,
    "window_y": null
  },
  "hotkeys": {
    "toggle_chat": "Ctrl+Shift+Space",
    "toggle_voice": "Ctrl+Shift+V",
    "toggle_mode": "Ctrl+Shift+M",
    "toggle_show_work": "Ctrl+Shift+W"
  },
  "show_work": false,
  "ui": {
    "theme": "dark-glass",
    "accent": "cyan",
    "chat_side": "left",
    "debug_mode": false
  },
  "plugins": {
    "enabled": ["shell", "app_launch", "notify", "git"]
  },
  "memory": {
    "enabled": true,
    "max_conversation_history": 200,
    "max_memory_injection": 8,
    "db_path": ""
  },
  "context": {
    "inject_active_window": true,
    "inject_clipboard": false
  },
  "developer_mode": {
    "enabled": false,
    "watch_dir": "",
    "auto_detect_repo": true,
    "inject_git_status": true
  },
  "schedules": [],
  "learning": {
    "enabled": true,
    "min_occurrences": 3,
    "min_confidence": 0.75,
    "suggest_while_busy": false,
    "auto_dismiss_seconds": 30
  },
  "proactive": {
    "enabled": false,
    "quiet_hours_start": "22:00",
    "quiet_hours_end": "08:00",
    "max_nudges_per_day": 3,
    "watchers": {
      "git_uncommitted": { "enabled": false, "threshold_minutes": 120 },
      "test_failures": { "enabled": false, "failure_threshold": 3 },
      "long_process": { "enabled": false, "threshold_hours": 8 },
      "idle_digest": { "enabled": false, "trigger_time": "18:00" },
      "memory_nudge": { "enabled": false }
    }
  },
  "persona": {
    "active": "walle",
    "tts_enabled": false,
    "tts_provider": "system"
  },
  "insights": {
    "hotkey": "Ctrl+Shift+I"
  },
  "marketplace": {
    "registry_url": "https://registry.walle.dev/v1",
    "auto_check_updates": true
  }
}
